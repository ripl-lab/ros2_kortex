<?xml version="1.0"?>

<robot name="gen3" xmlns:xacro="http://ros.org/wiki/xacro">

    <!-- Arguments -->
    <xacro:arg name="arm" default="gen3" />
    <xacro:arg name="dof" default="" />
    <xacro:arg name="vision" default="false" />
    <xacro:arg name="robot_ip" default="192.168.11.11" />
    <xacro:arg name="username" default="admin" />
    <xacro:arg name="password" default="admin" />
    <xacro:arg name="port" default="10000" />
    <xacro:arg name="port_realtime" default="10001" />
    <xacro:arg name="session_inactivity_timeout_ms" default="60000" />
    <xacro:arg name="connection_inactivity_timeout_ms" default="2000" />
    <xacro:arg name="gripper" default="" />
    <xacro:arg name="gripper_joint_name" default="finger_joint" />
    <xacro:arg name="gripper_max_velocity" default="100.0" />
    <xacro:arg name="gripper_max_force" default="100.0" />
    <xacro:arg name="wrench_filter_coefficient" default="0.05" />
    <xacro:arg name="wrench_force_deadband" default="2.0" />
    <xacro:arg name="wrench_torque_deadband" default="0.2" />
    <xacro:arg name="wrench_force_limit" default="40.0" />
    <xacro:arg name="wrench_torque_limit" default="8.0" />
    <xacro:arg name="wrench_force_stop_threshold" default="80.0" />
    <xacro:arg name="wrench_torque_stop_threshold" default="15.0" />
    <xacro:arg name="wrench_bias_force_x" default="0.0" />
    <xacro:arg name="wrench_bias_force_y" default="0.0" />
    <xacro:arg name="wrench_bias_force_z" default="0.0" />
    <xacro:arg name="wrench_bias_torque_x" default="0.0" />
    <xacro:arg name="wrench_bias_torque_y" default="0.0" />
    <xacro:arg name="wrench_bias_torque_z" default="0.0" />
    <xacro:arg name="feedback_timeout" default="0.1" />
    <xacro:arg name="max_joint_command_velocity" default="0.25" />
    <xacro:arg name="joint_limit_margin" default="0.02" />
    <xacro:arg name="sim_gazebo" default="false" />
    <xacro:arg name="sim_ignition" default="false" />
    <xacro:arg name="sim_isaac" default="false" />
    <xacro:arg name="prefix" default="" />
    <xacro:arg name="use_fake_hardware" default="false" />
    <xacro:arg name="fake_sensor_commands" default="false" />
    <xacro:arg name="use_internal_bus_gripper_comm" default="false" />
    <xacro:arg name="use_external_cable" default="false" />
    <xacro:arg name="include_clarius" default="true" />

    <xacro:include filename="$(find kortex_description)/robots/kortex_robot.xacro" />
    <!-- initial position for simulations (Mock Hardware, Gazebo, Ignition) -->
    <xacro:arg name="initial_positions_file" default="$(find kortex_description)/config/initial_positions.yaml"/>
    <!-- convert to property to use substitution in function -->
    <xacro:property name="initial_positions_file" default="$(arg initial_positions_file)"/>
    <link name="world" />
    <xacro:load_robot
        parent="world"
        arm="$(arg arm)"
        gripper="$(arg gripper)"
        gripper_joint_name="$(arg gripper_joint_name)"
        gripper_max_velocity="$(arg gripper_max_velocity)"
        gripper_max_force="$(arg gripper_max_force)"
        wrench_filter_coefficient="$(arg wrench_filter_coefficient)"
        wrench_force_deadband="$(arg wrench_force_deadband)"
        wrench_torque_deadband="$(arg wrench_torque_deadband)"
        wrench_force_limit="$(arg wrench_force_limit)"
        wrench_torque_limit="$(arg wrench_torque_limit)"
        wrench_force_stop_threshold="$(arg wrench_force_stop_threshold)"
        wrench_torque_stop_threshold="$(arg wrench_torque_stop_threshold)"
        wrench_bias_force_x="$(arg wrench_bias_force_x)"
        wrench_bias_force_y="$(arg wrench_bias_force_y)"
        wrench_bias_force_z="$(arg wrench_bias_force_z)"
        wrench_bias_torque_x="$(arg wrench_bias_torque_x)"
        wrench_bias_torque_y="$(arg wrench_bias_torque_y)"
        wrench_bias_torque_z="$(arg wrench_bias_torque_z)"
        feedback_timeout="$(arg feedback_timeout)"
        max_joint_command_velocity="$(arg max_joint_command_velocity)"
        joint_limit_margin="$(arg joint_limit_margin)"
        dof="$(arg dof)"
        vision="$(arg vision)"
        robot_ip="$(arg robot_ip)"
        username="$(arg username)"
        password="$(arg password)"
        port="$(arg port)"
        port_realtime="$(arg port_realtime)"
        session_inactivity_timeout_ms="$(arg session_inactivity_timeout_ms)"
        connection_inactivity_timeout_ms="$(arg connection_inactivity_timeout_ms)"
        use_internal_bus_gripper_comm="$(arg use_internal_bus_gripper_comm)"
        prefix="$(arg prefix)"
        use_fake_hardware="$(arg use_fake_hardware)"
        fake_sensor_commands="$(arg fake_sensor_commands)"
        sim_gazebo="$(arg sim_gazebo)"
        sim_ignition="$(arg sim_ignition)"
        sim_isaac="$(arg sim_isaac)"
        use_external_cable="$(arg use_external_cable)"
        include_clarius="$(arg include_clarius)"
        initial_positions="${xacro.load_yaml(initial_positions_file)}" >
        <origin xyz="0 0 0" rpy="0 0 0" />  <!-- position robot in the world -->
    </xacro:load_robot>

</robot>
