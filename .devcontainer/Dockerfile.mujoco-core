FROM ros:humble-ros-core-jammy

ARG USERNAME=vscode
ARG USER_UID=1000
ARG USER_GID=${USER_UID}

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=humble
ENV COLCON_WS=/workspace/ros2_kortex_ws
ENV RMW_IMPLEMENTATION=rmw_fastrtps_cpp
ENV VIRTUAL_ENV=/workspace/ros2_kortex_ws/.venv
ENV PATH=/workspace/ros2_kortex_ws/.venv/bin:${PATH}

RUN apt-get update && apt-get install -y --no-install-recommends \
    bash-completion \
    build-essential \
    cmake \
    extra-cmake-modules \
    git \
    iputils-ping \
    less \
    libcap-dev \
    libglfw3-dev \
    libopencv-dev \
    libpcl-dev \
    libexpected-dev \
    libtinyxml2-dev \
    libwayland-bin \
    libwayland-dev \
    libx11-dev \
    libxcursor-dev \
    libxi-dev \
    libxinerama-dev \
    libxkbcommon-dev \
    libxrandr-dev \
    pkg-config \
    python3-argcomplete \
    python3-colcon-common-extensions \
    python3-pip \
    python3-rosdep \
    python3-scipy \
    python3-vcstool \
    python3-venv \
    ros-humble-ackermann-msgs \
    ros-humble-angles \
    ros-humble-backward-ros \
    ros-humble-control-toolbox \
    ros-humble-cv-bridge \
    ros-humble-example-interfaces \
    ros-humble-generate-parameter-library \
    ros-humble-kinematics-interface \
    ros-humble-kinematics-interface-kdl \
    ros-humble-pcl-conversions \
    ros-humble-perception-pcl \
    ros-humble-rmw-cyclonedds-cpp \
    ros-humble-robot-state-publisher \
    ros-humble-rsl \
    ros-humble-tf2-eigen \
    ros-humble-tf2-geometry-msgs \
    ros-humble-tf2-kdl \
    ros-humble-tf2-ros \
    ros-humble-urdfdom-py \
    ros-humble-xacro \
    sudo \
    vim \
    wayland-protocols \
    xorg-dev \
    && rm -rf /var/lib/apt/lists/*

RUN if ! getent group ${USER_GID} >/dev/null; then groupadd --gid ${USER_GID} ${USERNAME}; fi \
    && useradd --uid ${USER_UID} --gid ${USER_GID} -m ${USERNAME} -s /bin/bash \
    && echo "${USERNAME} ALL=(root) NOPASSWD:ALL" >/etc/sudoers.d/${USERNAME} \
    && chmod 0440 /etc/sudoers.d/${USERNAME}

RUN rosdep init || true

RUN printf '%s\n' \
    'source /opt/ros/humble/setup.bash' \
    'if [ -f /workspace/ros2_kortex_ws/install/setup.bash ]; then source /workspace/ros2_kortex_ws/install/setup.bash; fi' \
    'if [ -f /workspace/ros2_kortex_ws/.venv/bin/activate ]; then source /workspace/ros2_kortex_ws/.venv/bin/activate; fi' \
    >/etc/profile.d/ros2_kortex_ws.sh \
    && printf '%s\n' \
    '' \
    'source /opt/ros/humble/setup.bash' \
    'if [ -f /workspace/ros2_kortex_ws/install/setup.bash ]; then source /workspace/ros2_kortex_ws/install/setup.bash; fi' \
    'if [ -f /workspace/ros2_kortex_ws/.venv/bin/activate ]; then source /workspace/ros2_kortex_ws/.venv/bin/activate; fi' \
    >> /home/${USERNAME}/.bashrc \
    && chown -R ${USERNAME}:${USER_GID} /home/${USERNAME}

USER ${USERNAME}
WORKDIR ${COLCON_WS}
